rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.id is string &&
             data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role in ['admin', 'friend'];
    }

    function isValidNotification(data) {
      return data.recipientId is string && isValidId(data.recipientId) &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             data.read is bool;
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow delete: if false;
    }

    // Real-Time Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (existing().recipientId == request.auth.uid || existing().senderId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isSignedIn() && existing().recipientId == request.auth.uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read', 'actionTaken', 'updatedAt']);
      allow delete: if isSignedIn() && (existing().recipientId == request.auth.uid || existing().senderId == request.auth.uid);
    }
  }
}
